# ==============================================================================
# 🌊 AquaPulse Backend - Plantilla de Variables de Entorno (.env.example)
# NUNCA incluyas contraseñas reales ni claves en este archivo.
# ==============================================================================

# Entorno de ejecución: "development" o "production" (en producción se desactivan /docs y /redoc)
ENVIRONMENT=development

# Clave maestra de cifrado para firma JWT y tokens (OBLIGATORIA)
# El arranque del servidor fallará si falta esta variable.
# Genera una clave aleatoria de 64 caracteres (ej: openssl rand -base64 48)
SECRET_KEY=

# Conexión a Base de Datos PostgreSQL (ej. Session Pooler de Supabase)
DATABASE_URL=postgresql://usuario:contrasena@aws-0-region.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# Orígenes CORS autorizados (separados por coma, lista blanca estricta)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://aquapulse.vercel.app

# Web Push API (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@aquapulse.io

# Token secreto para el endpoint protegido de Cron (/api/cron/send-reminders)
# Debe enviarse en la cabecera HTTP: X-CRON-SECRET
CRON_SECRET=

# Google Gemini API Key para diagnósticos predictivos y escáner visual de tests
GEMINI_API_KEY=
VISION_MODEL=gemini-3.1-flash-lite
