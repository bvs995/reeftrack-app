# ==============================================================================
# 🌊 AquaPulse Backend - Configuración de Entorno
# ==============================================================================

# Clave de API de Google Gemini para reconocimiento visual de test kits (Hanna, Salifert, etc.)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelo de visión a utilizar (recomendado: gemini-2.5-flash o gemini-1.5-flash)
VISION_MODEL=gemini-2.5-flash

# Base de datos (opcional en desarrollo, por defecto usa SQLite)
# DATABASE_URL=postgresql://aquapulse:password@localhost:5432/aquatracker

# Orígenes CORS permitidos (separados por coma o * en desarrollo)
ALLOWED_ORIGINS=*
