# ==============================================================================
# 🌊 AquaReef Backend - Plantilla de Variables de Entorno (.env.example)
# NUNCA incluyas contraseñas reales ni claves en este archivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO Y CONFIGURACIÓN GENERAL
# ------------------------------------------------------------------------------
# Entorno de ejecución: "development" o "production"
# En producción se desactivan /docs, /redoc y se validan estrictamente las credenciales.
ENVIRONMENT=development

# Clave maestra de cifrado para firma JWT y tokens (OBLIGATORIA)
# El arranque del servidor fallará si falta esta variable.
# Genera una clave aleatoria segura (ej: openssl rand -base64 48)
SECRET_KEY=
# Alias opcional/legado para SECRET_KEY:
# JWT_SECRET=

# URL base del frontend para enlaces en correos y redirecciones seguras
FRONTEND_URL=http://localhost:5173

# Orígenes CORS autorizados (separados por coma, lista blanca estricta)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://www.aquareef.app

# Resolución de la IP real del cliente para rate limits (ver DEPLOYMENT.md §5)
# En desarrollo sin proxy no hace falta nada. En Render: TRUSTED_PROXY_HOPS=1, PROXY_SHARED_SECRET
# igual a ORIGIN_SECRET de Vercel y FORWARDED_ALLOW_IPS sin definir (nunca '*': uvicorn la lee y
# tomaría la primera IP de X-Forwarded-For, que el cliente puede falsificar).
TRUSTED_PROXY_HOPS=0
PROXY_SHARED_SECRET=
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (POSTGRESQL / SQLITE)
# ------------------------------------------------------------------------------
# Conexión a Base de Datos PostgreSQL (ej. Session Pooler de Supabase) o SQLite local
DATABASE_URL=postgresql://usuario:contrasena@aws-0-region.pooler.supabase.com:5432/postgres
# Parámetros del pool de conexiones SQLAlchemy
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
# Desactivar DDL defensivo en entornos que usen exclusivamente migraciones de Alembic
DISABLE_DEFENSIVE_DDL=false

# ------------------------------------------------------------------------------
# 3. CORREO TRANSACCIONAL (EMAIL SERVICE)
# ------------------------------------------------------------------------------
# Proveedor transaccional: "resend", "brevo", "smtp" o "console" (en dev/test)
# En producción (ENVIRONMENT=production) es OBLIGATORIO configurar resend, brevo o smtp.
EMAIL_PROVIDER=console

# API Key para proveedores HTTP (Resend o Brevo)
EMAIL_API_KEY=

# Dirección de correo remitente autorizada
EMAIL_FROM=no-reply@aquareef.app

# Configuración alternativa para proveedor SMTP (cuando EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_TLS=true

# Forzar verificación de correo electrónico para activar cuentas nuevas (true/false)
REQUIRE_EMAIL_VERIFICATION=false

# ------------------------------------------------------------------------------
# 4. CONTROL DE TASA (RATE LIMITING)
# ------------------------------------------------------------------------------
# Límites de intentos de autenticación (login, registro, reseteo de contraseña)
AUTH_RATE_LIMIT_EMAIL_MAX=5
AUTH_RATE_LIMIT_IP_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Límites diarios de escaneos y operaciones de IA por usuario
SCAN_DAILY_LIMIT_FREE=5
SCAN_DAILY_LIMIT_PREMIUM=50
SCAN_DAILY_LIMIT_ADMIN=999

# ------------------------------------------------------------------------------
# 5. INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI API)
# ------------------------------------------------------------------------------
# Clave de API de Google Gemini (requerida para diagnósticos y escáner visual)
GEMINI_API_KEY=
# Alias opcional:
# GOOGLE_API_KEY=

# Modelo oficial primario de Gemini para diagnósticos estructurados
GEMINI_MODEL=gemini-3.8-flash

# Modelo ligero de visión para escáner fotográfico de pruebas de agua
VISION_MODEL=gemini-3.1-flash-lite

# Nivel de facturación de Gemini ("pay-as-you-go" o "paid" en producción; "free" en dev)
# En producción, GEMINI_TIER=free impedirá el arranque para proteger la privacidad de los usuarios
GEMINI_TIER=free

# Presupuestos de gasto mensual en USD (diagnósticos Y escaneos con cámara). Al alcanzarlos, la app
# deja de llamar a Gemini: diagnósticos por reglas y escaneo deshabilitado hasta el mes siguiente.
# Es un freno de la app; el límite duro está en Google AI Studio → Spend → Monthly spend cap.
GEMINI_MONTHLY_BUDGET_USD=50.0
USER_MONTHLY_AI_BUDGET_USD=2.0

# Precios por millón de tokens (USD) para estimar el gasto. Cópialos de la página de precios de
# Gemini para tus modelos (GEMINI_MODEL / VISION_MODEL). Por defecto son altos a propósito.
GEMINI_PRICE_INPUT_PER_M=0.50
GEMINI_PRICE_OUTPUT_PER_M=3.00

# ------------------------------------------------------------------------------
# 6. NOTIFICACIONES PUSH WEB (VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@aquareef.app

# ------------------------------------------------------------------------------
# 7. TAREAS PROGRAMADAS Y SEGURIDAD CRON
# ------------------------------------------------------------------------------
# Token secreto para el endpoint protegido de Cron (/api/cron/send-reminders)
# Debe enviarse en la cabecera HTTP: X-CRON-SECRET
CRON_SECRET=
